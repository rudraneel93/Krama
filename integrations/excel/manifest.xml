<?xml version="1.0" encoding="UTF-8"?>
<!-- PIM Column Check, Excel task-pane add-in.
     Replace https://pim-rules.vercel.app/excel with the HTTPS host serving src/ before sideloading
     or submitting. Generate a fresh <Id> GUID per publisher if this is forked. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>6b1c4e2a-7f3d-4c8e-9a51-2d0f8e6b9c17</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Rudraneel Das</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Krama Column Check"/>
  <Description DefaultValue="Finds the rule an ordered column follows and highlights the rows that break it."/>
  <IconUrl DefaultValue="https://pim-rules.vercel.app/excel/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://pim-rules.vercel.app/excel/icon-64.png"/>
  <SupportUrl DefaultValue="https://pim-rules.vercel.app/docs#excel"/>
  <AppDomains>
    <AppDomain>https://pim-rules.vercel.app</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.7"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://pim-rules.vercel.app/excel/taskpane"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="PIM.Group">
                <Label resid="PIM.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="PIM.Icon16"/>
                  <bt:Image size="32" resid="PIM.Icon32"/>
                  <bt:Image size="80" resid="PIM.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="PIM.OpenPane">
                  <Label resid="PIM.ButtonLabel"/>
                  <Supertip>
                    <Title resid="PIM.ButtonLabel"/>
                    <Description resid="PIM.ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="PIM.Icon16"/>
                    <bt:Image size="32" resid="PIM.Icon32"/>
                    <bt:Image size="80" resid="PIM.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PIM.Pane</TaskpaneId>
                    <SourceLocation resid="PIM.PaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="PIM.Icon16" DefaultValue="https://pim-rules.vercel.app/excel/icon-16.png"/>
        <bt:Image id="PIM.Icon32" DefaultValue="https://pim-rules.vercel.app/excel/icon-32.png"/>
        <bt:Image id="PIM.Icon80" DefaultValue="https://pim-rules.vercel.app/excel/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="PIM.PaneUrl" DefaultValue="https://pim-rules.vercel.app/excel/taskpane"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="PIM.GroupLabel" DefaultValue="Krama"/>
        <bt:String id="PIM.ButtonLabel" DefaultValue="Check column"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="PIM.ButtonTip" DefaultValue="Find the rule a column follows and highlight rows that break it."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
